# Copy to server/.env and edit. server/.env is git-ignored and must never be shared.
PORT=4000
# SQLite file (created on first run). `npm run seed` RESETS this file unless SEED_RESET=0.
DB_FILE=./data/understage.db
# Dev secrets: replace with long random strings (e.g. `openssl rand -hex 32`). REQUIRED when NODE_ENV=production.
JWT_SECRET=change-me
INVITE_SECRET=change-me
IDENTIFIER_PEPPER=change-me
# In dev the OTP code is printed in the server log ("[otp] ...") and returned to the app. Set 0 to hide it from API responses.
DEV_RETURN_OTP=1
# Phone that becomes owner of the seeded demo workspace — sign in on your iPhone with this number.
SEED_OWNER_PHONE=+447700900001
# Optional: token for /admin endpoints (no admin UI is built)
ADMIN_TOKEN=
# Optional: Expo push (needs a dev build with APNs credentials; off by default)
EXPO_PUSH_ENABLED=0
# Optional: TURN for calls across networks (not configured = same-network/STUN only)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: real SMS (not tested in this build)
SMS_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Dev-only: allow the paywall's "dev" subscription activation
SUBSCRIPTIONS_DEV=1
