# Copy to .env (project root, next to package.json) and edit. .env is git-ignored.
# Your Mac's LAN IP + server port. The iPhone must be on the same Wi-Fi. Find the IP with:
#   ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Optional: Socket.IO URL if different from the API (defaults to EXPO_PUBLIC_API_URL)
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.20:4000
